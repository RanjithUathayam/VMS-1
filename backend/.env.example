# Copy this file to .env and fill in real values. Never commit .env.

# Server Configuration
API_PORT=4201

# Primary MS SQL Database (WMS_Uathayam)
DB_USER=
DB_PASSWORD=
DB_SERVER=localhost
DB_DATABASE=
DB_PORT=1433
DB_OPTIONS_TRUSTSERVERCERTIFICATE=true

# Secondary WMS database — used by GRN Pushing. Required; there is no hardcoded fallback.
WMS2_DB_SERVER=
WMS2_DB_USER=
WMS2_DB_PASSWORD=
WMS2_DB_DATABASE=
WMS2_DB_PORT=1433

# ERP integration
ERP_API_URL=
ERP_CLIENT_ID=
ERP_CLIENT_SECRET=

# Session auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates all issued sessions.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Interakt WhatsApp API (Basic auth token) — used for OTP delivery and notifications
INTERAKT_API_TOKEN=
WHATSAPP_NOTIFY_PHONE=

# Comma-separated list of frontend origins allowed to call this API (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
